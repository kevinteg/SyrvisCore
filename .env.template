# SyrvisCore runtime configuration template
#
# The real file lives at $SYRVIS_HOME/config/.env and is GENERATED by
# `syrvis setup` (0600 — it holds tokens/secrets). This template documents the
# exact schema setup writes, for reference and for hand-crafted dev installs.
# NEVER commit a populated .env to version control.

# Installation
SYRVIS_HOME=/volume1/syrviscore
SYRVIS_DATA_DIR=/volume1/syrviscore/data

# Network (macvlan) — Traefik gets a dedicated LAN IP so it can bind 80/443
# alongside DSM. Reserve TRAEFIK_IP and SHIM_IP outside your DHCP range.
NETWORK_INTERFACE=ovs_eth0
NETWORK_SUBNET=192.168.1.0/24
NETWORK_GATEWAY=192.168.1.1
TRAEFIK_IP=192.168.1.100
SHIM_IP=192.168.1.101

# Synology NAS
NAS_IP=192.168.1.2

# Synology Services (DSM-native apps proxied through Traefik)
SYNOLOGY_DSM_ENABLED=false
SYNOLOGY_PHOTOS_ENABLED=false
SYNOLOGY_DRIVE_ENABLED=false
SYNOLOGY_AUDIO_ENABLED=false
SYNOLOGY_VIDEO_ENABLED=false
SYNOLOGY_WEBDAV_ENABLED=false

# Domain & SSL
DOMAIN=example.com
ACME_EMAIL=
# Cloudflare DNS-01 challenge token (Zone:DNS:Edit) — required for valid certs on
# internal/private-IP (split-horizon) names like dsm/portainer/dash. When set,
# Traefik issues + auto-renews via DNS instead of HTTP-01.
CLOUDFLARE_DNS_API_TOKEN=

# Cloudflare Tunnel (optional — remote access without port-forwarding)
CLOUDFLARE_TUNNEL_TOKEN=

# SyrvisCore Dashboard (web UI at DASHBOARD_SUBDOMAIN.DOMAIN)
DASHBOARD_SUBDOMAIN=dash
# Auth: cloudflare | oidc | both | none  (none = LAN/dev, no auth)
DASHBOARD_AUTH_MODE=none
# Allow Layer 2 service add/remove/start/stop from the dashboard (needs WITH_L2_TOOLS image)
ENABLE_L2_MUTATIONS=false
# Signs the local session cookie (set a long random value in production)
DASHBOARD_SESSION_SECRET=
# Host alias used when the dashboard prints `ssh <target> '...'` for privileged ops
SSH_TARGET=nas

# Dashboard auth — Cloudflare Access (remote + hairpin)
CLOUDFLARE_ACCESS_TEAM=
CLOUDFLARE_ACCESS_AUD=

# Dashboard auth — local OIDC SSO (Synology SSO Server by default; any OIDC IdP)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=

# Cloudflare DDNS (optional — favonia/cloudflare-ddns updates records on IP change)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DDNS_RECORDS=
CLOUDFLARE_DDNS_PROXIED=true

# Traefik
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_API_DASHBOARD=true

# Portainer
PORTAINER_BIND_PORT=9443

# System
TZ=UTC
