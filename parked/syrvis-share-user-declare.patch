+class TestHealSeamShells:
+    def test_absent_seam_account_skipped_not_created(self, tmp_path):
+        passwd = tmp_path / "passwd"
+        group = tmp_path / "group"
+        passwd.write_text("root:x:0:0:root:/root:/bin/ash\n")
+        group.write_text("users:x:100:\n")
+        b = DsmUserBackend(passwd_path=passwd, group_path=group, run=lambda argv: ("", 1))
+        healed = heal_seam_shells(b)
+        assert healed == {"syrvis-operator": "absent", "syrvis-reader": "absent"}
+        assert "syrvis-operator" not in passwd.read_text()
