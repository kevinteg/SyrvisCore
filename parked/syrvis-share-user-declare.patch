@@ -0,0 +1,556 @@
+"""
+DSM local users as declared state — the ``syrvis user declare|list`` plane.
+
+A deployment repo declares its human-account posture (local DSM users,
+``nologin`` shells, ``users``-only group membership); this verb converges DSM
+to it from a resolved JSON payload on stdin (docs/share-user-declare-spec.md):
+
+    <users.json> | sudo syrvis user declare --json
+
+Unlike the share plane, every mutation here uses a form the estate has already
+executed live (the seam provision script + runbooks): ``synouser --add`` for
+create, ``synogroup --memberadd`` for membership, and a surgical, count-checked
+``/etc/passwd`` rewrite for the login shell. Reads come straight from
+``/etc/passwd`` + ``/etc/group`` (exactly what the deployment's account checks
+parse today) — no bracket-text parsing of ``synouser --get``.
+
+Hard boundaries (each has a test):
+
+- **Passwords are never touched.** The schema has no password field and no
+  code path reads or changes one. Creating a MISSING user requires some
+  password for ``synouser --add``, so create installs a cryptographically
+  random throwaway (the provision script's proven pattern) and reports
+  ``password: unset (owner ceremony required)`` — the real credential ceremony
+  stays human.
+- **Structurally non-destructive**: no delete/disable/expire code path; group
+  membership is additive-only (extra memberships are reported, never removed).
+- **No privilege minting**: asserting membership of ``administrators`` or
+  ``docker`` (root-equivalent on DSM) is refused at validation.
+- **Seam self-preservation**: ANY DSM user-database write regenerates
+  ``/etc/passwd`` and reverts the seam accounts (``syrvis-operator``,
+  ``syrvis-reader``) to ``/sbin/nologin`` — severing the seam this verb
+  arrived on. After converging, :func:`heal_seam_shells` re-asserts
+  ``/bin/sh`` on both in the SAME invocation (the boot hook's self-heal,
+  reported under ``seam_selfheal``). The in-flight SSH session survives
+  regardless; the heal keeps the NEXT call alive.
+
+Kept import-light and Python 3.8-clean (stdlib only).
+"""
+
+import os
+import re
+import secrets
+import subprocess
+import tempfile
+from pathlib import Path
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+from syrviscore.errors import SyrvisError
+from syrviscore.service_schema import NAME_RE
+
+USERS_API_VERSION = "syrvis-users/v1"
+
+# ---------------------------------------------------------------------------
+# The frozen payload schema — the wire contract artifact (see shares.py for
+# the freeze mechanics; tests/test_payload_schemas.py pins the sha256).
+# ---------------------------------------------------------------------------
+
+FULL_NAME_MAX = 64
+ALLOWED_SHELLS = ("/sbin/nologin", "/bin/sh")
+# DSM's docker group is root-equivalent and admin membership is exactly what
+# the human-identity posture forbids — the seam must not be able to mint
+# either. OWNER-DECISION through the DSM UI only.
+FORBIDDEN_GROUPS = frozenset({"administrators", "docker"})
+USERNAME_PATTERN = NAME_RE.pattern
+
+USERS_PAYLOAD_SCHEMA = {
+    "$id": "syrvis-users/v1",
+    "type": "object",
+    "required": ["apiVersion", "users"],
+    "additionalProperties": False,
+    "properties": {
+        "apiVersion": {"const": USERS_API_VERSION},
+        "users": {
+            "type": "object",
+            "minProperties": 1,
+            "propertyNames": {"pattern": USERNAME_PATTERN},
+            "additionalProperties": {
+                "type": "object",
+                "required": ["shell", "groups"],
+                "additionalProperties": False,
+                "properties": {
+                    "full_name": {"type": "string", "maxLength": FULL_NAME_MAX},
+                    "shell": {"enum": list(ALLOWED_SHELLS)},
+                    "groups": {
+                        "type": "array",
+                        "items": {
+                            "type": "string",
+                            "pattern": USERNAME_PATTERN,
+                            "not": {"enum": sorted(FORBIDDEN_GROUPS)},
+                        },
+                    },
+                },
+            },
+        },
+    },
+}
+
+_USER_PROPS = USERS_PAYLOAD_SCHEMA["properties"]["users"]["additionalProperties"]
+ALLOWED_USER_KEYS = frozenset(_USER_PROPS["properties"].keys())
+REQUIRED_USER_KEYS = frozenset(_USER_PROPS["required"])
+
+_USERNAME_RE = re.compile(USERNAME_PATTERN)
+
+# The operator-seam accounts DSM keeps reverting to nologin (design lineage:
+# the provision script + boot hook heal exactly these two).
+SEAM_SHELL_USERS = ("syrvis-operator", "syrvis-reader")
+SEAM_SHELL = "/bin/sh"
+
+PASSWD_PATH = Path("/etc/passwd")
+GROUP_PATH = Path("/etc/group")
+
+
+class UserError(SyrvisError):
+    """An invalid users payload, a guard refusal, or a DSM backend failure."""
+
+    code = "user_plane_error"
+
+
+def _no_control(value: str) -> bool:
+    return not any(ord(c) < 0x20 or ord(c) == 0x7F for c in value)
+
+
+class UsersBundle:
+    """A validated ``syrvis-users/v1`` payload (mapping of username -> spec)."""
+
+    def __init__(self, users: Dict[str, Dict[str, Any]]):
+        self.users = users
+
+    @classmethod
+    def from_dict(cls, data: Any) -> "UsersBundle":
+        if not isinstance(data, dict):
+            raise UserError("users payload must be a mapping")
+        unknown = set(data.keys()) - {"apiVersion", "users"}
+        if unknown:
+            raise UserError(
+                "unknown payload keys: {} (allowed: apiVersion, users)".format(
+                    ", ".join(sorted(unknown))
+                )
+            )
+        api = data.get("apiVersion")
+        if api != USERS_API_VERSION:
+            raise UserError(
+                "unsupported payload apiVersion {!r} (expected {!r})".format(api, USERS_API_VERSION)
+            )
+        raw = data.get("users")
+        if not isinstance(raw, dict) or not raw:
+            raise UserError("'users' must be a non-empty mapping of username -> spec")
+
+        users: Dict[str, Dict[str, Any]] = {}
+        for name, spec in raw.items():
+            users[name] = cls._parse_user(name, spec)
+        return cls(users)
+
+    @staticmethod
+    def _parse_user(name: Any, spec: Any) -> Dict[str, Any]:
+        if not isinstance(name, str) or not _USERNAME_RE.fullmatch(name):
+            raise UserError("invalid username {!r} (must match {})".format(name, USERNAME_PATTERN))
+        if not isinstance(spec, dict):
+            raise UserError("user {!r} must be a mapping".format(name))
+        unknown = set(spec.keys()) - ALLOWED_USER_KEYS
+        if unknown:
+            raise UserError(
+                "user {!r}: unknown keys {} (allowed: {})".format(
+                    name, ", ".join(sorted(unknown)), ", ".join(sorted(ALLOWED_USER_KEYS))
+                )
+            )
+        missing = REQUIRED_USER_KEYS - set(spec.keys())
+        if missing:
+            raise UserError(
+                "user {!r}: missing required keys {}".format(name, ", ".join(sorted(missing)))
+            )
+
+        shell = spec["shell"]
+        if shell not in ALLOWED_SHELLS:
+            raise UserError(
+                "user {!r}: shell must be one of {} (got {!r})".format(
+                    name, ", ".join(ALLOWED_SHELLS), shell
+                )
+            )
+
+        groups = spec["groups"]
+        if not isinstance(groups, list) or not all(
+            isinstance(g, str) and NAME_RE.fullmatch(g) for g in groups
+        ):
+            raise UserError(
+                "user {!r}: 'groups' must be a list of group names matching {}".format(
+                    name, NAME_RE.pattern
+                )
+            )
+        forbidden = FORBIDDEN_GROUPS.intersection(groups)
+        if forbidden:
+            raise UserError(
+                "user {!r}: refusing to assert membership of {} — privileged group "
+                "membership is OWNER-DECISION (DSM UI), never a seam converge".format(
+                    name, ", ".join(sorted(forbidden))
+                )
+            )
+
+        full_name = spec.get("full_name", "")
+        if (
+            not isinstance(full_name, str)
+            or len(full_name) > FULL_NAME_MAX
+            or not _no_control(full_name)
+            or ":" in full_name  # a colon would corrupt the passwd gecos field
+        ):
+            raise UserError(
+                "user {!r}: full_name must be a single-line string of at most "
+                "{} chars with no ':'".format(name, FULL_NAME_MAX)
+            )
+
+        return {
+            "full_name": full_name,
+            "shell": shell,
+            "groups": sorted(set(groups)),
+        }
+
+
+# ---------------------------------------------------------------------------
+# The DSM backend — /etc/passwd + /etc/group reads, proven-form mutations.
+# ---------------------------------------------------------------------------
+
+
+class DsmUserBackend:
+    """DSM local-user state via the user database files + synouser/synogroup.
+
+    Paths and ``run`` are injectable so the backend is fully testable without
+    a NAS (and a test can never touch the real /etc). Mutations assume the
+    caller is root (the seam invokes user verbs under ``sudo -n``).
+    """
+
+    def __init__(
+        self,
+        passwd_path: Path = PASSWD_PATH,
+        group_path: Path = GROUP_PATH,
+        run: Optional[Callable[[List[str]], Any]] = None,
+        timeout_s: int = 30,
+    ) -> None:
+        self._passwd = Path(passwd_path)
+        self._group = Path(group_path)
+        self._timeout = timeout_s
+        self._run = run or self._subprocess_run
+
+    def _subprocess_run(self, argv: List[str]):
+        proc = subprocess.run(argv, capture_output=True, text=True, timeout=self._timeout)
+        return proc.stdout + proc.stderr, proc.returncode
+
+    # -- reads (the user database files — what the estate's checks parse) ----
+
+    def _passwd_rows(self) -> List[List[str]]:
+        try:
+            text = self._passwd.read_text()
+        except OSError as e:
+            raise UserError("cannot read {}: {}".format(self._passwd, e))
+        return [line.split(":") for line in text.splitlines() if line and ":" in line]
+
+    def get_user(self, name: str) -> Optional[Dict[str, Any]]:
+        """The passwd row projected to a dict, or None if absent."""
+        for row in self._passwd_rows():
+            if row[0] == name and len(row) >= 7:
+                return {
+                    "name": row[0],
+                    "uid": int(row[2]) if row[2].isdigit() else None,
+                    "full_name": row[4],
+                    "home": row[5],
+                    "shell": row[6],
+                }
+        return None
+
+    def list_users(self) -> List[Dict[str, Any]]:
+        """All passwd rows (the ``user list`` read enumerates; declare never does)."""
+        return [
+            {
+                "name": row[0],
+                "uid": int(row[2]) if row[2].isdigit() else None,
+                "full_name": row[4],
+                "home": row[5],
+                "shell": row[6],
+            }
+            for row in self._passwd_rows()
+            if len(row) >= 7
+        ]
+
+    def groups_of(self, name: str) -> List[str]:
+        """Group names listing ``name`` as a member (secondary memberships)."""
+        try:
+            text = self._group.read_text()
+        except OSError as e:
+            raise UserError("cannot read {}: {}".format(self._group, e))
+        out = []
+        for line in text.splitlines():
+            parts = line.split(":")
+            if len(parts) >= 4:
+                members = [m for m in parts[3].split(",") if m]
+                if name in members:
+                    out.append(parts[0])
+        return sorted(out)
+
+    # -- mutations (live-verified forms only) --------------------------------
+
+    def add_user(self, name: str, full_name: str) -> None:
+        """Create a local user via the provision script's proven synouser form.
+
+        The mandatory password argument is a cryptographically random throwaway
+        that is never recorded anywhere — the account is unusable until the
+        human credential ceremony sets a real one (spec §5.5). It transits the
+        NAS-local process table for the duration of the call, exactly like the
+        provisioning path; acceptable for a random discard, and the reason no
+        code path ever accepts a CHOSEN password.
+        """
+        randpw = secrets.token_hex(24)
+        # DSM synouser --add: username password "full name" expired(0|1) mail AppPrivilege
+        _, rc = self._run_checked(
+            ["/usr/syno/sbin/synouser", "--add", name, randpw, full_name, "0", "", ""]
+        )
+        if rc != 0:
+            raise UserError(
+                "synouser --add {} failed (rc={}); create the user via DSM "
+                "Control Panel and re-declare".format(name, rc)
+            )
+
+    def add_to_group(self, group: str, member: str) -> None:
+        """Additive membership via synogroup --memberadd (never replaces a list)."""
+        out, rc = self._run_checked(["/usr/syno/sbin/synogroup", "--memberadd", group, member])
+        if rc != 0:
+            raise UserError(
+                "synogroup --memberadd {} {} failed (rc={}): {} — very old DSMs "
+                "lack --memberadd; add via DSM Control Panel and re-declare".format(
+                    group, member, rc, out.strip()[:200]
+                )
+            )
+
+    def _run_checked(self, argv: List[str]) -> Tuple[str, int]:
+        try:
+            return self._run(argv)
+        except Exception as exc:  # noqa: BLE001 - binary missing / timeout
+            raise UserError("{} failed: {}".format(argv[0], exc))
+
+    def set_shell(self, name: str, shell: str) -> None:
+        """Surgically set ONE user's login shell in the passwd file.
+
+        The provision script's pattern reimplemented: rewrite only field 7 of
+        the one matching row, refuse to install unless the record count is
+        unchanged AND the edit took, then atomic-rename into place (a crash
+        mid-write can never leave a torn user database).
+        """
+        try:
+            text = self._passwd.read_text()
+        except OSError as e:
+            raise UserError("cannot read {}: {}".format(self._passwd, e))
+        lines = text.splitlines()
+        edited = False
+        new_lines = []
+        for line in lines:
+            parts = line.split(":")
+            if parts and parts[0] == name and len(parts) >= 7:
+                parts[6] = shell
+                new_lines.append(":".join(parts))
+                edited = True
+            else:
+                new_lines.append(line)
+        if not edited:
+            raise UserError(
+                "user {!r} not found in {} — cannot set shell".format(name, self._passwd)
+            )
+        if len(new_lines) != len(lines):  # pragma: no cover - structurally impossible
+            raise UserError("refusing to install {} (record count changed)".format(self._passwd))
+        content = "\n".join(new_lines) + ("\n" if text.endswith("\n") else "")
+
+        fd, tmp_name = tempfile.mkstemp(
+            dir=str(self._passwd.parent), prefix=".{}.syrvis.".format(self._passwd.name)
+        )
+        try:
+            with os.fdopen(fd, "w") as f:
+                f.write(content)
+            os.chmod(tmp_name, 0o644)
+            os.replace(tmp_name, str(self._passwd))
+        except BaseException:
+            try:
+                os.unlink(tmp_name)
+            except OSError:
+                pass
+            raise
+
+
+# ---------------------------------------------------------------------------
+# Plan -> converge -> re-read (+ the seam-shell self-heal)
+# ---------------------------------------------------------------------------
+
+
+def plan_users(bundle: UsersBundle, backend: DsmUserBackend) -> Dict[str, Any]:
+    """Compute the per-user converge plan. Read-only."""
+    plan: Dict[str, Any] = {}
+    for name, spec in bundle.users.items():
+        current = backend.get_user(name)
+        entry: Dict[str, Any] = {"spec": spec, "changes": {}, "notes": []}
+        if current is None:
+            entry["action"] = "create"
+            entry["changes"]["shell"] = {"from": None, "to": spec["shell"]}
+            entry["changes"]["groups"] = {"add": spec["groups"]}
+            entry["notes"].append("password: unset (owner ceremony required)")
+            plan[name] = entry
+            continue
+
+        if current["shell"] != spec["shell"]:
+            entry["changes"]["shell"] = {"from": current["shell"], "to": spec["shell"]}
+        have_groups = set(backend.groups_of(name))
+        missing = sorted(set(spec["groups"]) - have_groups)
+        if missing:
+            entry["changes"]["groups"] = {"add": missing}
+        extra = sorted(have_groups - set(spec["groups"]))
+        if extra:
+            # Additive-only: extra memberships are REPORTED, never removed
+            # (removal is OWNER-DECISION; the deployment's checks alert on
+            # privileged extras).
+            entry["unmanaged_groups"] = extra
+        if spec["full_name"] and current["full_name"] != spec["full_name"]:
+            # Report-only: a gecos rewrite is not worth a user-database
+            # regeneration (synouser --modify is unreliable across DSM versions).
+            entry["notes"].append(
+                "full_name drift (actual {!r}, declared {!r}) — report-only".format(
+                    current["full_name"], spec["full_name"]
+                )
+            )
+        entry["action"] = "update" if entry["changes"] else "unchanged"
+        plan[name] = entry
+    return plan
+
+
+def apply_user_plan(plan: Dict[str, Any], backend: DsmUserBackend) -> Tuple[Dict[str, Any], bool]:
+    """Execute a plan, re-read, and report — returns (report, ok)."""
+    report: Dict[str, Any] = {}
+    ok = True
+    for name, entry in plan.items():
+        spec = entry["spec"]
+        result: Dict[str, Any] = {
+            "action": entry["action"],
+            "changes": entry["changes"],
+            "notes": list(entry["notes"]),
+            "converged": True,
+            "errors": [],
+        }
+        if "unmanaged_groups" in entry:
+            result["unmanaged_groups"] = entry["unmanaged_groups"]
+        try:
+            if entry["action"] == "create":
+                backend.add_user(name, spec["full_name"])
+            if "shell" in entry["changes"]:
+                backend.set_shell(name, spec["shell"])
+            for group in entry["changes"].get("groups", {}).get("add", []):
+                backend.add_to_group(group, name)
+        except UserError as e:
+            result["errors"].append(str(e))
+            result["converged"] = False
+            ok = False
+            report[name] = result
+            continue
+
+        # Re-read: residual drift must surface loudly, never as a false
+        # convergence (e.g. a memberadd that "succeeded" but did not take).
+        try:
+            current = backend.get_user(name)
+            residual: Dict[str, Any] = {}
+            if current is None:
+                residual["user"] = "still missing after create"
+            else:
+                if current["shell"] != spec["shell"]:
+                    residual["shell"] = {"actual": current["shell"], "declared": spec["shell"]}
+                still_missing = sorted(set(spec["groups"]) - set(backend.groups_of(name)))
+                if still_missing:
+                    residual["groups"] = {"missing": still_missing}
+        except UserError as e:
+            result["errors"].append("post-apply re-read failed: {}".format(e))
+            result["converged"] = False
+            ok = False
+            report[name] = result
+            continue
+        if residual:
+            result["residual"] = residual
+            result["converged"] = False
+            ok = False
+        report[name] = result
+    return report, ok
+
+
+def heal_seam_shells(backend: DsmUserBackend) -> Dict[str, str]:
+    """Re-assert /bin/sh on the seam accounts (the design/39 §5 trap).
+
+    ANY DSM user-database write regenerates /etc/passwd and reverts the seam
+    accounts to /sbin/nologin, severing the operator seam this verb arrived
+    on. Idempotent + guarded (a missing seam account is skipped, not created);
+    the boot hook and the schedule self-heal job assert the same posture.
+    """
+    healed: Dict[str, str] = {}
+    for user in SEAM_SHELL_USERS:
+        current = backend.get_user(user)
+        if current is None:
+            healed[user] = "absent"
+        elif current["shell"] == SEAM_SHELL:
+            healed[user] = "ok"
+        else:
+            backend.set_shell(user, SEAM_SHELL)
+            healed[user] = "healed"
+    return healed
+
+
+def declare_users(
+    bundle: UsersBundle,
+    backend: Optional[DsmUserBackend] = None,
+    dry_run: bool = False,
+) -> Dict[str, Any]:
+    """The library entry behind ``syrvis user declare [--dry-run]``."""
+    backend = backend or DsmUserBackend()
+    plan = plan_users(bundle, backend)
+    if dry_run:
+        users_report = {}
+        for name, entry in plan.items():
+            row = {
+                "action": entry["action"],
+                "changes": entry["changes"],
+                "notes": entry["notes"],
+            }
+            if "unmanaged_groups" in entry:
+                row["unmanaged_groups"] = entry["unmanaged_groups"]
+            users_report[name] = row
+        return {"dry_run": True, "users": users_report, "ok": True}
+
+    users_report, ok = apply_user_plan(plan, backend)
+    # The same-invocation seam self-heal (spec §5.6). Runs unconditionally
+    # after converge: cheap, idempotent, and a mutating run above may have
+    # just regenerated /etc/passwd underneath the seam.
+    try:
+        selfheal = heal_seam_shells(backend)
+    except UserError as e:
+        selfheal = {"error": str(e)}
+        ok = False
+    return {"dry_run": False, "users": users_report, "seam_selfheal": selfheal, "ok": ok}
+
+
+def list_users(backend: Optional[DsmUserBackend] = None) -> Dict[str, Any]:
+    """The library entry behind ``syrvis user list --json`` (read-only).
+
+    Enumerates the local user database with shells and group memberships; the
+    deployment side owns the posture comparison. Never touches passwords or
+    shadow state; DSM app privileges are out of scope (spec §8).
+    """
+    backend = backend or DsmUserBackend()
+    out = []
+    for user in backend.list_users():
+        row = dict(user)
+        try:
+            row["groups"] = backend.groups_of(user["name"])
+        except UserError as e:
+            row["groups"] = None
+            row["groups_error"] = str(e)
+        out.append(row)
+    return {"users": sorted(out, key=lambda u: u.get("name") or "")}
diff --git a/tests/test_payload_schemas.py b/tests/test_payload_schemas.py
new file mode 100644
index 0000000..7ceb65a
--- /dev/null
+++ b/tests/test_payload_schemas.py
@@ -0,0 +1,89 @@
+"""Freeze guards for the share/user declare payload schemas (the wire contract).
+
+The schemas are exported constants a deployment's tooling may verify payloads
+against (the seam catalog embeds them), so an ACCIDENTAL edit is a silent
+contract break. These tests pin the sha256 of each schema's canonical JSON: a
+deliberate contract change updates the digest here AND bumps the apiVersion —
+in the same commit, as a visible decision.
+
+The literal key-set assertions are the second witness: the validators derive
+their allowed keys from the schema constants, so without an independent
+restatement here a schema edit would self-consistently slip through.
+"""
+
+import hashlib
+import json
+
+from syrviscore.shares import SHARES_API_VERSION, SHARES_PAYLOAD_SCHEMA
+from syrviscore.users import USERS_API_VERSION, USERS_PAYLOAD_SCHEMA
+
+SHARES_SCHEMA_SHA256 = "e0504edd600eddd124d5502461f26f4222d861902e9f4e13f2be5eb613e75bad"
+USERS_SCHEMA_SHA256 = "a4211d27d033d7b3f0fb775f5b911ee1de5ae53d2c280c0d1a92e7aa85b249f3"
+
+
+def _digest(schema):
+    canon = json.dumps(schema, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(canon.encode()).hexdigest()
+
+
+class TestSharesSchemaFrozen:
+    def test_digest_pinned(self):
+        assert _digest(SHARES_PAYLOAD_SCHEMA) == SHARES_SCHEMA_SHA256, (
+            "SHARES_PAYLOAD_SCHEMA changed. If deliberate: bump SHARES_API_VERSION "
+            "and update SHARES_SCHEMA_SHA256 in the same commit."
+        )
+
+    def test_api_version_matches_id(self):
+        assert SHARES_PAYLOAD_SCHEMA["$id"] == SHARES_API_VERSION == "syrvis-shares/v1"
+
+    def test_share_key_set_literal(self):
+        props = SHARES_PAYLOAD_SCHEMA["properties"]["shares"]["additionalProperties"]
+        assert set(props["properties"]) == {
+            "volume",
+            "description",
+            "hide_unauthorized",
+            "recycle_bin",
+            "encrypted",
+            "acl",
+        }
+        assert set(props["required"]) == {
+            "volume",
+            "hide_unauthorized",
+            "recycle_bin",
+            "encrypted",
+            "acl",
+        }
+        # The named-removal contract: rw/ro grants plus the explicit "none".
+        acl = props["properties"]["acl"]
+        assert acl["additionalProperties"]["enum"] == ["rw", "ro", "none"]
+
+    def test_json_serializable(self):
+        json.dumps(SHARES_PAYLOAD_SCHEMA)
+
+
+class TestUsersSchemaFrozen:
+    def test_digest_pinned(self):
+        assert _digest(USERS_PAYLOAD_SCHEMA) == USERS_SCHEMA_SHA256, (
+            "USERS_PAYLOAD_SCHEMA changed. If deliberate: bump USERS_API_VERSION "
+            "and update USERS_SCHEMA_SHA256 in the same commit."
+        )
+
+    def test_api_version_matches_id(self):
+        assert USERS_PAYLOAD_SCHEMA["$id"] == USERS_API_VERSION == "syrvis-users/v1"
+
+    def test_user_key_set_literal(self):
+        props = USERS_PAYLOAD_SCHEMA["properties"]["users"]["additionalProperties"]
+        assert set(props["properties"]) == {"full_name", "shell", "groups"}
+        assert set(props["required"]) == {"shell", "groups"}
+        # The password boundary is STRUCTURAL: no password-ish field may ever
+        # appear in the schema (the credential ceremony stays human).
+        assert not any("pass" in key.lower() for key in props["properties"])
+        assert props["properties"]["shell"]["enum"] == ["/sbin/nologin", "/bin/sh"]
+        # Privileged groups are refused by schema, not just by code.
+        assert props["properties"]["groups"]["items"]["not"]["enum"] == [
+            "administrators",
+            "docker",
+        ]
+
+    def test_json_serializable(self):
+        json.dumps(USERS_PAYLOAD_SCHEMA)
diff --git a/tests/test_seam_verbs.py b/tests/test_seam_verbs.py
