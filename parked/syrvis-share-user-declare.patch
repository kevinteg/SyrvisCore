index 0000000..80dc528
--- /dev/null
+++ b/tests/test_seam_verbs.py
@@ -0,0 +1,160 @@
+"""The data-plane seam entries + the verb catalog (seam verbs / gen verbs).
+
+Three concerns:
+
+1. The new registry entries carry the ratified tiers and shapes (declares =
+   sudo converge, plans/lists = read-only, seam_verbs = no sudo; no slots).
+2. The catalog is a faithful, JSON-serializable projection of the registry,
+   embedding the frozen payload schemas, and both emitters (`gen verbs` and
+   `syrvis seam verbs --json`) produce the identical document.
+3. The committed sudoers/shim artifacts in the MCP package equal this source
+   tree's generator output — the service-side mirror of the MCP package's G18
+   drift test, so `make check` (which does not run the MCP suite) still fails
+   loudly when a registry change forgets to regenerate the artifacts.
+"""
+
+import json
+from pathlib import Path
+
+from click.testing import CliRunner
+
+from syrviscore.__version__ import __version__
+from syrviscore.seam import gen, registry
+from syrviscore.shares import SHARES_PAYLOAD_SCHEMA
+from syrviscore.users import USERS_PAYLOAD_SCHEMA
+
+REPO = Path(__file__).resolve().parents[1]
+MCP_DEPLOY = REPO / "packages" / "syrviscore-mcp" / "deploy"
+
+NEW_IDS = {
+    "share_declare_plan",
+    "share_declare",
+    "share_list",
+    "user_declare_plan",
+    "user_declare",
+    "user_list",
+    "seam_verbs",
+}
+
+
+class TestRegistryEntries:
+    def test_all_present(self):
+        assert NEW_IDS <= set(registry.COMMANDS_BY_ID)
+
+    def test_declares_are_sudo_converge_not_destructive(self):
+        for cmd_id in ("share_declare", "user_declare"):
+            cmd = registry.get_command(cmd_id)
+            assert cmd.sudo and not cmd.read_only and not cmd.destructive
+            assert cmd.flags == ["--json"]
+
+    def test_plans_are_sudo_read_only(self):
+        for cmd_id in ("share_declare_plan", "user_declare_plan"):
+            cmd = registry.get_command(cmd_id)
+            assert cmd.sudo and cmd.read_only and not cmd.destructive
+            assert cmd.flags == ["--dry-run", "--json"]
+
+    def test_lists_are_sudo_read_only(self):
+        for cmd_id in ("share_list", "user_list"):
+            cmd = registry.get_command(cmd_id)
+            assert cmd.sudo and cmd.read_only and cmd.flags == ["--json"]
+
+    def test_seam_verbs_is_plain_read(self):
+        cmd = registry.get_command("seam_verbs")
+        assert not cmd.sudo and cmd.read_only and not cmd.destructive
+
+    def test_no_slots_anywhere(self):
+        """The payload names its targets — nothing user-chosen crosses argv."""
+        for cmd_id in NEW_IDS:
+            cmd = registry.get_command(cmd_id)
+            assert cmd.positional is None
+            assert all(not isinstance(f, registry.FlagValue) for f in cmd.flags)
+
+    def test_stdin_wire_formats(self):
+        assert registry.get_command("share_declare").stdin == "syrvis-shares/v1"
+        assert registry.get_command("share_declare_plan").stdin == "syrvis-shares/v1"
+        assert registry.get_command("user_declare").stdin == "syrvis-users/v1"
+        assert registry.get_command("user_declare_plan").stdin == "syrvis-users/v1"
+        for cmd_id in ("share_list", "user_list", "seam_verbs"):
+            assert registry.get_command(cmd_id).stdin is None
+        # The pre-existing stdin writers are annotated too (catalog honesty).
+        assert registry.get_command("apply").stdin == "syrvis-instance/v1"
+        assert registry.get_command("deploy").stdin == "syrvis-bundle/v1"
+        assert registry.get_command("secret_set").stdin == "text"
+        assert registry.get_command("config_set").stdin == "text"
+
+    def test_rendered_shapes(self):
+        sudoers = gen.render_sudoers()
+        for shape in (
+            "share declare --dry-run --json",
+            "share declare --json",
+            "share list --json",
+            "user declare --dry-run --json",
+            "user declare --json",
+            "user list --json",
+        ):
+            assert "/volume1/syrviscore/bin/syrvis {}".format(shape) in sudoers
+        # seam_verbs is not sudo -> must NOT appear in the sudoers policy...
+        assert "seam verbs" not in sudoers
+        # ...but must be an accepted shim shape.
+        assert '[ "${2}" = "seam" ] && [ "${3}" = "verbs" ]' in gen.render_shim()
+
+
+class TestCatalog:
+    def test_covers_every_command(self):
+        doc = registry.catalog()
+        assert doc["catalog_version"] == registry.CATALOG_VERSION == 1
+        assert {c["id"] for c in doc["commands"]} == set(registry.COMMANDS_BY_ID)
+
+    def test_json_serializable_round_trip(self):
+        doc = registry.catalog(service_version="1.2.3")
+        again = json.loads(json.dumps(doc))
+        assert again["service_version"] == "1.2.3"
+
+    def test_embeds_frozen_payload_schemas(self):
+        doc = registry.catalog()
+        assert doc["payloads"]["syrvis-shares/v1"] == SHARES_PAYLOAD_SCHEMA
+        assert doc["payloads"]["syrvis-users/v1"] == USERS_PAYLOAD_SCHEMA
+
+    def test_faithful_projection_of_a_slotted_command(self):
+        """Spot-check a command with flag slots + positional serializes fully
+        enough for a consumer to reconstruct its accepted argv shapes."""
+        doc = registry.catalog()
+        run = [c for c in doc["commands"] if c["id"] == "service_run"][0]
+        assert run["subcommand"] == ["service", "run"]
+        assert {"literal": "--image"} in run["flags"]
+        assert {"slot": {"name": "image", "kind": "image", "optional": False}} in run["flags"]
+        assert run["positional"] == {"name": "name", "kind": "name", "optional": False}
+
+    def test_gen_verbs_and_cli_emit_identical_documents(self, capsys):
+        rc = gen.main(["gen", "verbs"])
+        assert rc == 0
+        from_gen = json.loads(capsys.readouterr().out)
+
+        from syrviscore.cli import cli
+
+        r = CliRunner().invoke(cli, ["seam", "verbs", "--json"])
+        assert r.exit_code == 0, r.output
+        from_cli = json.loads(r.output)
+
+        assert from_gen == from_cli
+        assert from_cli["service_version"] == __version__
+
+
+class TestCommittedArtifactsCurrent:
+    """The service-side mirror of the MCP package's G18 drift test."""
+
+    def test_sudoers_matches_generator(self):
+        committed = (MCP_DEPLOY / "sudoers.d" / "syrviscore-mcp").read_text()
+        assert committed == gen.render_sudoers(), (
+            "committed sudoers drifted from the registry — regenerate with "
+            "`python -m syrviscore.seam.gen sudoers > packages/syrviscore-mcp/"
+            "deploy/sudoers.d/syrviscore-mcp`"
+        )
+
+    def test_shim_matches_generator(self):
+        committed = (MCP_DEPLOY / "ssh" / "syrvis-mcp-shim").read_text()
+        assert committed == gen.render_shim(), (
+            "committed shim drifted from the registry — regenerate with "
+            "`python -m syrviscore.seam.gen shim > packages/syrviscore-mcp/"
+            "deploy/ssh/syrvis-mcp-shim`"
+        )
diff --git a/tests/test_shares.py b/tests/test_shares.py
new file mode 100644
index 0000000..8caa49d
--- /dev/null
+++ b/tests/test_shares.py
@@ -0,0 +1,454 @@
+"""syrvis share declare|list — schema, guards, converge, honest reporting.
+
+Mirrors test_instance_apply.py's shape: schema strictness first (root parsing
+attacker-controlled stdin), then the converge semantics against a stateful
+fake DSM (the injected-run pattern from test_vms.py / test_macvlan_shim.py:
+the fake dispatches on the synowebapi argv and mutates modeled share state, so
+create/set/permission calls and the post-apply re-read are exercised end to
+end), then the CLI boundary with elevation stubbed.
+
+The blast-radius invariants each get an explicit test: payload scope, no
+destructive path, encrypted-create refusal, encryption/volume contradictions,
+named-removal-only ACLs, and the honest-residual-drift report when a backend
+call silently does not take.
+"""
+
+import json
+
+import pytest
+from click.testing import CliRunner
+
+from syrviscore import shares as shares_mod
+from syrviscore.shares import (
+    SHARES_API_VERSION,
+    DsmShareBackend,
+    ShareError,
+    SharesBundle,
+    declare_shares,
+    list_shares,
+    plan_shares,
+)
+
+
+def spec(**over):
+    d = {
+        "volume": "/volume5",
+        "hide_unauthorized": True,
+        "recycle_bin": False,
+        "encrypted": False,
+        "acl": {"kevin": "rw", "syrvis-reader": "ro"},
+    }
+    d.update(over)
+    return d
+
+
+def payload(**shares):
+    return {"apiVersion": SHARES_API_VERSION, "shares": shares or {"Books": spec()}}
+
+
+def dsm_row(name, **over):
+    row = {
+        "name": name,
+        "vol_path": "/volume5",
+        "desc": "",
+        "hide_unreadable": True,
+        "enable_recycle_bin": False,
+        "encryption": 0,
+    }
+    row.update(over)
+    return row
+
+
+class FakeDsm:
+    """Dispatches faked ``synowebapi`` argv, modeling share + permission state.
+
+    State: ``shares`` is name -> raw DSM row; ``perms`` is name -> {principal:
+    "rw"|"ro"}. Mutating methods update the state so the post-apply re-read
+    sees the result. ``inert_set``/``fail_set`` model a set call that silently
+    does not take / errors, for the honesty tests.
+    """
+
+    def __init__(self, shares=(), perms=None, inert_set=False, fail_set=()):
+        self.shares = {row["name"]: dict(row) for row in shares}
+        self.perms = {name: dict(v) for name, v in (perms or {}).items()}
+        self.inert_set = inert_set
+        self.fail_set = set(fail_set)  # share names whose `set` calls error
+        self.calls = []
+
+    def _params(self, argv):
+        assert argv[0] == "/usr/syno/bin/synowebapi" and argv[1] == "--exec"
+        params = dict(p.split("=", 1) for p in argv[2:])
+        return params
+
+    def __call__(self, argv):
+        self.calls.append(list(argv))
+        p = self._params(argv)
+        api, method = p["api"], p["method"]
+
+        if api == "SYNO.Core.Share" and method == "list":
+            return self._ok({"shares": [dict(r) for r in self.shares.values()]})
+        if api == "SYNO.Core.Share" and method == "create":
+            info = json.loads(p["shareinfo"])
+            name = info["name"]
+            self.shares[name] = dsm_row(
+                name,
+                vol_path=info["vol_path"],
+                desc=info.get("desc", ""),
+                hide_unreadable=False,  # DSM defaults, before set_share asserts
+                enable_recycle_bin=False,
+            )
+            return self._ok({})
+        if api == "SYNO.Core.Share" and method == "set":
+            name = json.loads(p["name"])
+            if name in self.fail_set:
+                return json.dumps({"success": False, "error": {"code": 3300}}), 0
+            if not self.inert_set:
+                self.shares[name].update(json.loads(p["shareinfo"]))
+            return self._ok({})
+        if api == "SYNO.Core.Share.Permission" and method == "list":
+            name = json.loads(p["name"])
+            items = [
+                {
+                    "name": principal,
+                    "is_writable": level == "rw",
+                    "is_readonly": level == "ro",
+                    "is_deny": False,
+                }
+                for principal, level in sorted(self.perms.get(name, {}).items())
+            ]
+            return self._ok({"items": items})
+        if api == "SYNO.Core.Share.Permission" and method == "set":
+            name = json.loads(p["name"])
+            if not self.inert_set:
+                for row in json.loads(p["user_group_info"]):
+                    grants = self.perms.setdefault(name, {})
+                    if row["is_writable"]:
+                        grants[row["name"]] = "rw"
+                    elif row["is_readonly"]:
+                        grants[row["name"]] = "ro"
+                    else:
+                        grants.pop(row["name"], None)
+            return self._ok({})
+        raise AssertionError("unexpected synowebapi call: {}".format(argv))
+
+    @staticmethod
+    def _ok(data):
+        return json.dumps({"success": True, "data": data}), 0
+
+    def mutating_calls(self):
+        return [c for c in self.calls if "method=create" in c or "method=set" in c]
+
+
+def backend(fake):
+    return DsmShareBackend(run=fake)
+
+
+# ---------------------------------------------------------------------------
+# Schema
+# ---------------------------------------------------------------------------
+
+
+class TestParse:
+    def test_not_a_mapping(self):
+        with pytest.raises(ShareError, match="mapping"):
+            SharesBundle.from_dict(["x"])
+
+    def test_wrong_api_version(self):
+        with pytest.raises(ShareError, match="apiVersion"):
+            SharesBundle.from_dict({"apiVersion": "syrvis-shares/v9", "shares": {"B": spec()}})
+
+    def test_unknown_top_level_key(self):
+        doc = payload()
+        doc["extra"] = 1
+        with pytest.raises(ShareError, match="unknown payload keys"):
+            SharesBundle.from_dict(doc)
+
+    def test_empty_shares(self):
+        with pytest.raises(ShareError, match="non-empty"):
+            SharesBundle.from_dict({"apiVersion": SHARES_API_VERSION, "shares": {}})
+
+    @pytest.mark.parametrize(
+        "name",
+        ["", "a/b", "a\\b", " Books", "Books ", "x" * 33, "bad\nname"],
+    )
+    def test_invalid_share_names(self, name):
+        with pytest.raises(ShareError, match="share name"):
+            SharesBundle.from_dict(payload(**{name: spec()}))
+
+    def test_space_inside_name_is_legal(self):
+        b = SharesBundle.from_dict(payload(**{"Secure Documents": spec()}))
+        assert "Secure Documents" in b.shares
+
+    def test_unknown_share_key(self):
+        with pytest.raises(ShareError, match="unknown keys"):
+            SharesBundle.from_dict(payload(Books=spec(sensitivity="low")))
+
+    def test_missing_required_key(self):
+        s = spec()
+        del s["recycle_bin"]
+        with pytest.raises(ShareError, match="missing required"):
+            SharesBundle.from_dict(payload(Books=s))
+
+    @pytest.mark.parametrize("volume", ["/volume", "/volume5/", "volume5", "/vol5", "/volume123"])
+    def test_bad_volume(self, volume):
+        with pytest.raises(ShareError, match="volume"):
+            SharesBundle.from_dict(payload(Books=spec(volume=volume)))
+
+    def test_flags_must_be_boolean(self):
+        with pytest.raises(ShareError, match="boolean"):
+            SharesBundle.from_dict(payload(Books=spec(recycle_bin="no")))
+
+    def test_bad_principal_and_level(self):
+        with pytest.raises(ShareError, match="principal"):
+            SharesBundle.from_dict(payload(Books=spec(acl={"Kevin!": "rw"})))
+        with pytest.raises(ShareError, match="ACL level"):
+            SharesBundle.from_dict(payload(Books=spec(acl={"kevin": "admin"})))
+
+    def test_description_default_and_caps(self):
+        b = SharesBundle.from_dict(payload())
+        assert b.shares["Books"]["description"] == ""
+        with pytest.raises(ShareError, match="description"):
+            SharesBundle.from_dict(payload(Books=spec(description="x" * 129)))
+
+
+# ---------------------------------------------------------------------------
+# Guards (all raise at PLAN time — nothing mutated)
+# ---------------------------------------------------------------------------
+
+
+class TestGuards:
+    def test_encrypted_create_refused(self):
+        fake = FakeDsm()
+        b = SharesBundle.from_dict(payload(Records=spec(encrypted=True)))
+        with pytest.raises(ShareError, match="ENCRYPTED share headlessly"):
+            plan_shares(b, backend(fake))
+        assert fake.mutating_calls() == []
+
+    def test_encryption_contradiction_refused(self):
+        fake = FakeDsm(shares=[dsm_row("Records", encryption=1)])
+        b = SharesBundle.from_dict(payload(Records=spec(encrypted=False)))
+        with pytest.raises(ShareError, match="create-time property"):
