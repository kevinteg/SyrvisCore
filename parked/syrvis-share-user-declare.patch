index 0000000..913de9e
--- /dev/null
+++ b/packages/syrviscore/src/syrviscore/shares.py
@@ -0,0 +1,633 @@
+"""
+DSM shared folders as declared state — the ``syrvis share declare|list`` plane.
+
+A deployment repo keeps a share registry (declared shared folders + a
+principal->rw|ro access matrix); these verbs make the platform its reconciler
+(docs/share-user-declare-spec.md). The payload is the RESOLVED DSM-level
+intent, rendered client-side from the registry and streamed over the operator
+seam on stdin (the ``apply`` pattern — nothing estate-specific crosses argv):
+
+    <shares.json> | sudo syrvis share declare --json
+
+Converge philosophy: compare, then change only what differs, then RE-READ and
+report residual drift honestly. The backend drives DSM's own web API on-box
+(``synowebapi --exec api=SYNO.Core.Share*`` — the API the DSM UI drives,
+root-only, JSON in/out; the same adapter precedent as vms.py). Every API call
+shape is isolated in :class:`DsmShareBackend` with a VERIFY-ON-NAS note: the
+shapes are asserted from DSM documentation, not yet executed against a live
+DSM, and the post-apply re-read turns a wrong assumption into loud residual
+drift instead of a false convergence.
+
+Blast-radius invariants (each has a test):
+
+- Only shares NAMED in the payload are read or touched — never
+  enumerate-and-converge (the read-only ``list`` verb enumerates; that is its
+  job, and the deployment's drift check owns the comparison).
+- Structurally non-destructive: no delete/rename/move code path exists. An
+  ACL grant is removed only for a principal the payload explicitly names with
+  ``"none"``; unnamed principals are reported as unmanaged drift, untouched.
+- Encryption is a CREATE-TIME, human decision: creating a share declared
+  ``encrypted: true`` is refused (Key Manager + key custody cannot ride a
+  headless argv); an existing encrypted share gets posture asserted only.
+  A declared/actual encryption mismatch is a contradiction -> guard error.
+
+Kept import-light and Python 3.8-clean (stdlib only — this also keeps the seam
+generator's run-from-source-tree property when it imports the schema).
+"""
+
+import json
+import re
+import subprocess
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+from syrviscore.errors import SyrvisError
+from syrviscore.service_schema import NAME_RE
+
+SHARES_API_VERSION = "syrvis-shares/v1"
+
+# ---------------------------------------------------------------------------
+# The frozen payload schema — the wire contract artifact.
+#
+# JSON-Schema-shaped, exported for external tooling (the catalog embeds it) and
+# the SOURCE the validator below derives its allowed keys/enums from, so code
+# and contract cannot diverge. tests/test_payload_schemas.py pins its sha256:
+# an accidental edit fails the test; a deliberate contract change updates the
+# digest AND bumps SHARES_API_VERSION.
+# ---------------------------------------------------------------------------
+
+SHARE_NAME_MAX = 32  # DSM's own shared-folder name cap
+DESCRIPTION_MAX = 128
+ACL_LEVELS = ("rw", "ro", "none")  # "none" = the NAMED removal form
+VOLUME_PATTERN = r"^/volume[0-9]{1,2}$"
+PRINCIPAL_PATTERN = NAME_RE.pattern  # principal slugs share the platform charset
+
+SHARES_PAYLOAD_SCHEMA = {
+    "$id": "syrvis-shares/v1",
+    "type": "object",
+    "required": ["apiVersion", "shares"],
+    "additionalProperties": False,
+    "properties": {
+        "apiVersion": {"const": SHARES_API_VERSION},
+        "shares": {
+            "type": "object",
+            "minProperties": 1,
+            "additionalProperties": {
+                "type": "object",
+                "required": ["volume", "hide_unauthorized", "recycle_bin", "encrypted", "acl"],
+                "additionalProperties": False,
+                "properties": {
+                    "volume": {"type": "string", "pattern": VOLUME_PATTERN},
+                    "description": {"type": "string", "maxLength": DESCRIPTION_MAX},
+                    "hide_unauthorized": {"type": "boolean"},
+                    "recycle_bin": {"type": "boolean"},
+                    "encrypted": {"type": "boolean"},
+                    "acl": {
+                        "type": "object",
+                        "propertyNames": {"pattern": PRINCIPAL_PATTERN},
+                        "additionalProperties": {"enum": list(ACL_LEVELS)},
+                    },
+                },
+            },
+        },
+    },
+}
+
+# Derived from the schema so the validator can never quietly diverge from the
+# published contract (the schema is the source; these are its projections).
+_SHARE_PROPS = SHARES_PAYLOAD_SCHEMA["properties"]["shares"]["additionalProperties"]
+ALLOWED_SHARE_KEYS = frozenset(_SHARE_PROPS["properties"].keys())
+REQUIRED_SHARE_KEYS = frozenset(_SHARE_PROPS["required"])
+
+_VOLUME_RE = re.compile(VOLUME_PATTERN)
+_PRINCIPAL_RE = re.compile(PRINCIPAL_PATTERN)
+
+
+class ShareError(SyrvisError):
+    """An invalid shares payload, a guard refusal, or a DSM backend failure."""
+
+    code = "share_plane_error"
+
+
+def _no_control(value: str) -> bool:
+    return not any(ord(c) < 0x20 or ord(c) == 0x7F for c in value)
+
+
+def _valid_share_name(name: Any) -> bool:
+    """DSM's naming envelope: 1-32 chars, printable, no path separators, no
+    leading/trailing space (spaces INSIDE are legal — e.g. 'Secure Documents')."""
+    if not isinstance(name, str) or not name or len(name) > SHARE_NAME_MAX:
+        return False
+    if not _no_control(name) or "/" in name or "\\" in name:
+        return False
+    return name == name.strip()
+
+
+class SharesBundle:
+    """A validated ``syrvis-shares/v1`` payload (mapping of share name -> spec)."""
+
+    def __init__(self, shares: Dict[str, Dict[str, Any]]):
+        self.shares = shares
+
+    @classmethod
+    def from_dict(cls, data: Any) -> "SharesBundle":
+        if not isinstance(data, dict):
+            raise ShareError("shares payload must be a mapping")
+        unknown = set(data.keys()) - {"apiVersion", "shares"}
+        if unknown:
+            raise ShareError(
+                "unknown payload keys: {} (allowed: apiVersion, shares)".format(
+                    ", ".join(sorted(unknown))
+                )
+            )
+        api = data.get("apiVersion")
+        if api != SHARES_API_VERSION:
+            raise ShareError(
+                "unsupported payload apiVersion {!r} (expected {!r})".format(
+                    api, SHARES_API_VERSION
+                )
+            )
+        raw = data.get("shares")
+        if not isinstance(raw, dict) or not raw:
+            raise ShareError("'shares' must be a non-empty mapping of share name -> spec")
+
+        shares: Dict[str, Dict[str, Any]] = {}
+        for name, spec in raw.items():
+            shares[name] = cls._parse_share(name, spec)
+        return cls(shares)
+
+    @staticmethod
+    def _parse_share(name: Any, spec: Any) -> Dict[str, Any]:
+        if not _valid_share_name(name):
+            raise ShareError(
+                "invalid share name {!r} (1-{} printable chars, no /\\, no edge spaces)".format(
+                    name, SHARE_NAME_MAX
+                )
+            )
+        if not isinstance(spec, dict):
+            raise ShareError("share {!r} must be a mapping".format(name))
+        unknown = set(spec.keys()) - ALLOWED_SHARE_KEYS
+        if unknown:
+            raise ShareError(
+                "share {!r}: unknown keys {} (allowed: {})".format(
+                    name, ", ".join(sorted(unknown)), ", ".join(sorted(ALLOWED_SHARE_KEYS))
+                )
+            )
+        missing = REQUIRED_SHARE_KEYS - set(spec.keys())
+        if missing:
+            raise ShareError(
+                "share {!r}: missing required keys {}".format(name, ", ".join(sorted(missing)))
+            )
+
+        volume = spec["volume"]
+        if not isinstance(volume, str) or not _VOLUME_RE.fullmatch(volume):
+            raise ShareError(
+                "share {!r}: volume {!r} must match {}".format(name, volume, VOLUME_PATTERN)
+            )
+        for flag in ("hide_unauthorized", "recycle_bin", "encrypted"):
+            if not isinstance(spec[flag], bool):
+                raise ShareError("share {!r}: {!r} must be a boolean".format(name, flag))
+
+        description = spec.get("description", "")
+        if (
+            not isinstance(description, str)
+            or len(description) > DESCRIPTION_MAX
+            or not _no_control(description)
+        ):
+            raise ShareError(
+                "share {!r}: description must be a single-line string of at most "
+                "{} chars".format(name, DESCRIPTION_MAX)
+            )
+
+        acl = spec["acl"]
+        if not isinstance(acl, dict):
+            raise ShareError(
+                "share {!r}: 'acl' must be a mapping of principal -> level".format(name)
+            )
+        for principal, level in acl.items():
+            if not isinstance(principal, str) or not _PRINCIPAL_RE.fullmatch(principal):
+                raise ShareError(
+                    "share {!r}: invalid ACL principal {!r} (must match {})".format(
+                        name, principal, PRINCIPAL_PATTERN
+                    )
+                )
+            if level not in ACL_LEVELS:
+                raise ShareError(
+                    "share {!r}: ACL level for {!r} must be one of {} (got {!r})".format(
+                        name, principal, "/".join(ACL_LEVELS), level
+                    )
+                )
+
+        return {
+            "volume": volume,
+            "description": description,
+            "hide_unauthorized": spec["hide_unauthorized"],
+            "recycle_bin": spec["recycle_bin"],
+            "encrypted": spec["encrypted"],
+            "acl": dict(acl),
+        }
+
+
+# ---------------------------------------------------------------------------
+# The DSM backend (synowebapi) — the ONLY privileged surface of this module.
+# ---------------------------------------------------------------------------
+
+
+class DsmShareBackend:
+    """Drives DSM shared folders via ``synowebapi --exec`` (root-only).
+
+    ``run`` is injectable so the backend is fully testable without a NAS: it
+    receives the argv list and returns (stdout, returncode) — the vms.py
+    adapter pattern. In production it defaults to a subprocess call (the seam
+    invokes share verbs under ``sudo -n``).
+
+    VERIFY-ON-NAS: the SYNO.Core.Share / SYNO.Core.Share.Permission parameter
+    shapes below are asserted from DSM API documentation and community usage,
+    not yet executed against a live DSM 7.2. First production use is gated on
+    ``share list`` + ``share declare --dry-run`` reading sanely (spec §6.2);
+    the declare path's post-apply re-read reports any wrong assumption as
+    residual drift.
+    """
+
+    SHARE_API = "SYNO.Core.Share"
+    PERM_API = "SYNO.Core.Share.Permission"
+
+    # The `additional` fields we ask list/get for — the posture the payload
+    # declares plus what the deployment's checks want to see.
+    _ADDITIONAL = json.dumps(
+        [
+            "hidden",
+            "encryption",
+            "enable_recycle_bin",
+            "recycle_bin_admin_only",
+            "hide_unreadable",
+            "vol_path",
+            "desc",
+        ]
+    )
+
+    def __init__(
+        self,
+        binary: str = "/usr/syno/bin/synowebapi",
+        run: Optional[Callable[[List[str]], Any]] = None,
+        timeout_s: int = 60,
+    ) -> None:
+        self._binary = binary
+        self._timeout = timeout_s
+        self._run = run or self._subprocess_run
+
+    def _subprocess_run(self, argv: List[str]):
+        proc = subprocess.run(argv, capture_output=True, text=True, timeout=self._timeout)
+        return proc.stdout, proc.returncode
+
+    def _exec(self, api: str, method: str, version: int = 1, **params: str) -> Dict[str, Any]:
+        argv = [
+            self._binary,
+            "--exec",
+            "api={}".format(api),
+            "version={}".format(version),
+            "method={}".format(method),
+        ]
+        for key, value in params.items():
+            argv.append("{}={}".format(key, value))
+        try:
+            stdout, rc = self._run(argv)
+        except Exception as exc:  # noqa: BLE001 - synowebapi missing / timeout
+            raise ShareError("synowebapi call failed: {}".format(exc))
+        try:
+            data = json.loads(stdout or "{}")
+        except ValueError:
+            raise ShareError("synowebapi returned non-JSON (rc={})".format(rc))
+        if not data.get("success", False):
+            err = data.get("error") or {}
+            raise ShareError("DSM API error on {}.{}: {}".format(api, method, err or "unknown"))
+        return data.get("data") or {}
+
+    # -- reads ---------------------------------------------------------------
+
+    def list_shares(self) -> List[Dict[str, Any]]:
+        """All shared folders with posture fields (the ``share list`` read)."""
+        data = self._exec(self.SHARE_API, "list", additional=self._ADDITIONAL)
+        return list(data.get("shares") or [])
+
+    def get_share(self, name: str) -> Optional[Dict[str, Any]]:
+        """One share's info, or None if it does not exist.
+
+        Implemented via list-and-pick rather than ``method=get``: a get on a
+        missing name raises an opaque DSM error code, while the list form lets
+        "absent" be a clean None (and one list call serves a whole payload via
+        the plan's cache).
+        """
+        for share in self.list_shares():
+            if share.get("name") == name:
+                return share
+        return None
+
+    def get_permissions(self, name: str) -> List[Dict[str, Any]]:
+        """The share's local-user permission rows (principal-level rw/ro/deny).
+
+        VERIFY-ON-NAS: Share.Permission list is user_group_type-filtered; we
+        read local users only (principals are local DSM users by design).
+        """
+        data = self._exec(
+            self.PERM_API,
+            "list",
+            name=_q(name),
+            user_group_type="local_user",
+        )
+        return list(data.get("items") or [])
+
+    # -- mutations (create / set / permissions) ------------------------------
+
+    def create_share(self, name: str, volume: str, description: str) -> None:
+        """Create a PLAINTEXT share (encrypted creation is refused upstream)."""
+        shareinfo = json.dumps(
+            {"name": name, "vol_path": volume, "desc": description}, sort_keys=True
+        )
+        self._exec(self.SHARE_API, "create", name=_q(name), shareinfo=shareinfo)
+
+    def set_share(self, name: str, fields: Dict[str, Any]) -> None:
+        """Assert posture fields on an existing share (partial shareinfo)."""
+        shareinfo = json.dumps(fields, sort_keys=True)
+        self._exec(self.SHARE_API, "set", name=_q(name), shareinfo=shareinfo)
+
+    def set_permission(self, name: str, principal: str, level: str) -> None:
+        """Set one local user's share-level permission (rw / ro / none).
+
+        VERIFY-ON-NAS: the permission row shape mirrors what Permission.list
+        returns; ``none`` clears both grants (no deny row — default-deny does
+        the rest, and a deny row is a stronger state than "not granted").
+        """
+        row = {
+            "name": principal,
+            "type": "local_user",
+            "is_writable": level == "rw",
+            "is_readonly": level == "ro",
+            "is_deny": False,
+            "is_custom": False,
+        }
+        self._exec(
+            self.PERM_API,
+            "set",
+            name=_q(name),
+            user_group_info=json.dumps([row], sort_keys=True),
+        )
+
+
+def _q(value: str) -> str:
+    """Quote a share name for a synowebapi string parameter.
+
+    synowebapi parses ``key=value`` params itself; wrapping the value in JSON
+    string quotes keeps names with spaces ('Secure Documents') one token AND
+    one well-formed API string. Each param is ONE argv element (list-form
+    subprocess, never a shell), so this is encoding, not escaping.
+    """
+    return json.dumps(value)
+
+
+# ---------------------------------------------------------------------------
+# Normalization: DSM's share/permission rows -> the payload's field vocabulary
+# ---------------------------------------------------------------------------
+
+
+def _norm_share(raw: Dict[str, Any]) -> Dict[str, Any]:
+    """Project a DSM share row onto the payload vocabulary (tolerant reads:
+    a field DSM did not return maps to None and simply reports as drift)."""
+    enc = raw.get("encryption")
+    encrypted = None if enc is None else bool(enc)
+    vol_path = raw.get("vol_path")
+    return {
+        "name": raw.get("name"),
+        "volume": vol_path,
+        "path": "{}/{}".format(vol_path, raw.get("name")) if vol_path else None,
+        "description": raw.get("desc"),
+        "hide_unauthorized": raw.get("hide_unreadable"),
+        "recycle_bin": raw.get("enable_recycle_bin"),
+        "encrypted": encrypted,
+        # eCryptfs shares report a mount state through the encryption field on
+        # DSM (1=mounted, 2=unmounted per observed API dumps) — surfaced raw so
+        # the deployment's checks can alert on an unmounted encrypted share.
+        "encryption_raw": enc,
+    }
+
+
+def _norm_perms(rows: List[Dict[str, Any]]) -> Dict[str, str]:
+    """Permission rows -> {principal: 'rw'|'ro'} (deny/none rows drop out)."""
+    out: Dict[str, str] = {}
+    for row in rows:
+        principal = row.get("name")
+        if not principal or row.get("is_deny"):
+            continue
+        if row.get("is_writable"):
+            out[principal] = "rw"
+        elif row.get("is_readonly"):
+            out[principal] = "ro"
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Plan -> converge -> re-read
+# ---------------------------------------------------------------------------
+
+_POSTURE_FIELDS = ("hide_unauthorized", "recycle_bin")
+
+# payload field -> the DSM shareinfo key set_share writes
+_SET_FIELD_MAP = {
+    "hide_unauthorized": "hide_unreadable",
+    "recycle_bin": "enable_recycle_bin",
+}
+
+
+def plan_shares(bundle: SharesBundle, backend: DsmShareBackend) -> Dict[str, Any]:
+    """Compute the per-share converge plan. Read-only; guard violations raise.
+
+    Guards run HERE, before any mutation, so a payload is applied
+    all-or-not-at-all at the guard layer (mirrors apply's validation-first
+    posture): encrypted-create refusals and encryption contradictions abort
+    the whole payload with nothing changed.
+    """
+    plan: Dict[str, Any] = {}
+    for name, spec in bundle.shares.items():
+        current_raw = backend.get_share(name)
+        entry: Dict[str, Any] = {
+            "spec": spec,
+            "changes": {},
+            "acl_changes": {},
+            "unmanaged_acl": [],
+        }
+        if current_raw is None:
+            if spec["encrypted"]:
+                raise ShareError(
+                    "share {!r}: refusing to create an ENCRYPTED share headlessly "
+                    "(Key Manager enrolment and key custody are a human, create-time "
+                    "ceremony — see the deployment runbook); create it there, then "
+                    "re-declare".format(name),
+                )
+            entry["action"] = "create"
+            entry["changes"] = {
+                field: {"from": None, "to": spec[field]}
+                for field in ("volume", "description") + _POSTURE_FIELDS
+            }
+            entry["acl_changes"] = {
+                principal: {"from": None, "to": level}
+                for principal, level in sorted(spec["acl"].items())
+                if level != "none"
+            }
+            plan[name] = entry
+            continue
+
+        current = _norm_share(current_raw)
+        if current["encrypted"] is not None and bool(current["encrypted"]) != spec["encrypted"]:
+            # A declared/actual encryption mismatch is a CONTRADICTION (share
+            # encryption is create-time), not drift to fix. Refuse loudly.
+            raise ShareError(
+                "share {!r}: declared encrypted={} but the share is encrypted={} — "
+                "encryption is a create-time property; fix the declaration or "
+                "recreate the share via the runbook".format(
+                    name, spec["encrypted"], bool(current["encrypted"])
+                )
+            )
+        if current["volume"] is not None and current["volume"] != spec["volume"]:
+            # Moving a share between volumes is a data migration, not a flag.
+            raise ShareError(
+                "share {!r}: declared volume {!r} but the share lives on {!r} — "
+                "moving a share is OWNER-DECISION (runbook), never a converge".format(
+                    name, spec["volume"], current["volume"]
+                )
+            )
+
+        for field in _POSTURE_FIELDS:
+            if current[field] is None or bool(current[field]) != spec[field]:
+                entry["changes"][field] = {"from": current[field], "to": spec[field]}
+
+        current_acl = _norm_perms(backend.get_permissions(name))
+        for principal, level in sorted(spec["acl"].items()):
+            have = current_acl.get(principal)
+            want = None if level == "none" else level
+            if have != want:
+                entry["acl_changes"][principal] = {"from": have, "to": want}
+        entry["unmanaged_acl"] = sorted(set(current_acl) - set(spec["acl"]))
+
+        entry["action"] = "update" if (entry["changes"] or entry["acl_changes"]) else "unchanged"
+        plan[name] = entry
+    return plan
+
+
+def apply_share_plan(plan: Dict[str, Any], backend: DsmShareBackend) -> Tuple[Dict[str, Any], bool]:
+    """Execute a plan, re-read, and report — returns (report, ok).
+
+    Per-share backend failures land in that share's ``errors`` and flip ok
+    False; other shares still converge (reconcile-style aggregation — a re-run
+    is idempotent and picks up where it failed).
+    """
+    report: Dict[str, Any] = {}
+    ok = True
+    for name, entry in plan.items():
+        spec = entry["spec"]
+        result = {
+            "action": entry["action"],
+            "changes": entry["changes"],
+            "acl_changes": entry["acl_changes"],
+            "unmanaged_acl": entry["unmanaged_acl"],
+            "converged": True,
+            "errors": [],
+        }
+        try:
+            if entry["action"] == "create":
+                backend.create_share(name, spec["volume"], spec["description"])
+            if entry["action"] in ("create", "update"):
+                set_fields = {
+                    _SET_FIELD_MAP[f]: spec[f]
+                    for f in _POSTURE_FIELDS
+                    if entry["action"] == "create" or f in entry["changes"]
+                }
+                if set_fields:
+                    backend.set_share(name, set_fields)
+                for principal, change in entry["acl_changes"].items():
+                    backend.set_permission(name, principal, spec["acl"].get(principal, "none"))
+        except ShareError as e:
+            result["errors"].append(str(e))
+            result["converged"] = False
+            ok = False
+            report[name] = result
+            continue
+
+        # Re-read and report RESIDUAL drift honestly: an imperfect backend
+        # assumption must surface here, never as a silent false convergence.
+        try:
+            residual = _residual_drift(name, spec, backend)
+        except ShareError as e:
+            result["errors"].append("post-apply re-read failed: {}".format(e))
+            result["converged"] = False
+            ok = False
+            report[name] = result
+            continue
+        if residual:
+            result["residual"] = residual
+            result["converged"] = False
+            ok = False
+        report[name] = result
+    return report, ok
+
+
+def _residual_drift(name: str, spec: Dict[str, Any], backend: DsmShareBackend) -> Dict[str, Any]:
+    residual: Dict[str, Any] = {}
+    current_raw = backend.get_share(name)
+    if current_raw is None:
+        return {"share": "still missing after create"}
+    current = _norm_share(current_raw)
+    for field in _POSTURE_FIELDS:
+        if current[field] is None or bool(current[field]) != spec[field]:
+            residual[field] = {"actual": current[field], "declared": spec[field]}
+    current_acl = _norm_perms(backend.get_permissions(name))
+    for principal, level in spec["acl"].items():
+        want = None if level == "none" else level
+        if current_acl.get(principal) != want:
+            residual.setdefault("acl", {})[principal] = {
+                "actual": current_acl.get(principal),
+                "declared": want,
+            }
+    return residual
+
+
+def declare_shares(
+    bundle: SharesBundle,
+    backend: Optional[DsmShareBackend] = None,
+    dry_run: bool = False,
+) -> Dict[str, Any]:
+    """The library entry behind ``syrvis share declare [--dry-run]``."""
+    backend = backend or DsmShareBackend()
+    plan = plan_shares(bundle, backend)
+    if dry_run:
+        shares_report = {
+            name: {
+                "action": entry["action"],
+                "changes": entry["changes"],
+                "acl_changes": entry["acl_changes"],
+                "unmanaged_acl": entry["unmanaged_acl"],
+            }
+            for name, entry in plan.items()
+        }
+        return {"dry_run": True, "shares": shares_report, "ok": True}
+    shares_report, ok = apply_share_plan(plan, backend)
+    return {"dry_run": False, "shares": shares_report, "ok": ok}
+
+
+def list_shares(backend: Optional[DsmShareBackend] = None) -> Dict[str, Any]:
+    """The library entry behind ``syrvis share list --json`` (read-only).
+
+    Enumerates ALL shares with normalized posture + the permission matrix; the
+    deployment side owns the comparison against its registry (undeclared-share
+    detection, ACL audit). No registry knowledge lives here.
+    """
+    backend = backend or DsmShareBackend()
+    out: List[Dict[str, Any]] = []
+    for raw in backend.list_shares():
+        share = _norm_share(raw)
+        name = share.get("name")
+        try:
+            share["acl"] = _norm_perms(backend.get_permissions(name)) if name else {}
+        except ShareError as e:
+            share["acl"] = None
+            share["acl_error"] = str(e)
+        out.append(share)
+    return {"shares": sorted(out, key=lambda s: s.get("name") or "")}
