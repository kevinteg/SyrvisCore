+    Command(
+        "user_declare_plan",
+        "syrvis",
+        ["user", "declare"],
+        sudo=True,
+        read_only=True,
+        flags=["--dry-run", "--json"],
+        stdin="syrvis-users/v1",
+        timeout_s=240,
+    ),
+    Command(
+        "user_declare",
+        "syrvis",
+        ["user", "declare"],
+        sudo=True,
+        flags=["--json"],
+        stdin="syrvis-users/v1",
+        timeout_s=240,
+    ),
+    Command("user_list", "syrvis", ["user", "list"], sudo=True, read_only=True, flags=["--json"]),
 ]
 
 COMMANDS_BY_ID = {c.id: c for c in COMMANDS}
@@ -646,3 +716,75 @@ def get_command(cmd_id: str) -> Command:
     if cmd_id not in COMMANDS_BY_ID:
         raise KeyError(f"unknown command id: {cmd_id}")
     return COMMANDS_BY_ID[cmd_id]
+
+
+# =============================================================================
+# The verb catalog — the machine-readable seam contract
+# =============================================================================
+
+# Bumped only on a BREAKING shape change of the catalog document; additive
+# fields do not bump it (the hostnames-report convention).
+CATALOG_VERSION = 1
+
+
+def catalog(service_version: Optional[str] = None) -> dict:
+    """Serialize the registry as the seam-contract catalog (a JSON-able dict).
+
+    The one document external tooling verifies call shapes against instead of
+    hardcoding them (design lineage: the deployment repo's CI drift check).
+    Emitted identically by two consumers:
+
+    - ``python -m syrviscore.seam.gen verbs``  (build/CI-side, bare source tree)
+    - ``syrvis seam verbs --json``             (the deployed instance, over the seam)
+
+    Slots serialize as ``{"slot": {"name", "kind", "optional"}}`` and literal
+    flags as ``{"literal": "--json"}``, so a consumer can reconstruct the exact
+    accepted argv shapes. ``payloads`` carries the frozen stdin schemas for the
+    declare verbs (imported lazily; omitted if the modules are unavailable so
+    this function keeps the generator's run-anywhere property).
+    """
+
+    def _slot(slot: Slot) -> dict:
+        return {"name": slot.name, "kind": slot.kind, "optional": slot.optional}
+
+    commands = []
+    for cmd in COMMANDS:
+        flags = []
+        for flag in cmd.flags:
+            if isinstance(flag, FlagValue):
+                flags.append({"slot": _slot(flag.slot)})
+            else:
+                flags.append({"literal": flag})
+        commands.append(
+            {
+                "id": cmd.id,
+                "cli": cmd.cli,
+                "subcommand": list(cmd.subcommand),
+                "sudo": cmd.sudo,
+                "read_only": cmd.read_only,
+                "destructive": cmd.destructive,
+                "expect_json": cmd.expect_json,
+                "flags": flags,
+                "install_path": cmd.install_path,
+                "positional": _slot(cmd.positional) if cmd.positional else None,
+                "timeout_s": cmd.timeout_s,
+                "stdin": cmd.stdin,
+            }
+        )
+
+    payloads = {}
+    try:  # lazy + guarded: keeps the module import-light and gen run-anywhere
+        from syrviscore.shares import SHARES_API_VERSION, SHARES_PAYLOAD_SCHEMA
+        from syrviscore.users import USERS_API_VERSION, USERS_PAYLOAD_SCHEMA
+
+        payloads[SHARES_API_VERSION] = SHARES_PAYLOAD_SCHEMA
+        payloads[USERS_API_VERSION] = USERS_PAYLOAD_SCHEMA
+    except ImportError:  # pragma: no cover - only a partial/foreign install
+        pass
+
+    return {
+        "catalog_version": CATALOG_VERSION,
+        "service_version": service_version,
+        "commands": commands,
+        "payloads": payloads,
+    }
