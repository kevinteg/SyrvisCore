+"""syrvis user declare|list — schema, guards, converge, the seam-shell trap.
+
+Backend reads run against tmp passwd/group files (injectable paths — a test
+can never touch the real /etc, mirroring test_macvlan_shim's ifcfg fixture);
+mutations run through a fake ``run`` that models synouser/synogroup AND the
+DSM trap this verb must survive: any user-database write regenerates
+/etc/passwd, reverting the seam accounts to /sbin/nologin. The declare path
+must re-assert those shells in the same invocation (spec §5.6).
+
+The hard boundaries each get an explicit test: no password field, random
+throwaway at create only, no delete/disable surface, additive-only groups,
+privileged-group refusal.
+"""
+
+import json
+
+import pytest
+from click.testing import CliRunner
+
+from syrviscore import users as users_mod
+from syrviscore.users import (
+    USERS_API_VERSION,
+    DsmUserBackend,
+    UserError,
+    UsersBundle,
+    declare_users,
+    heal_seam_shells,
+    list_users,
+)
+
+PASSWD = """root:x:0:0:root:/root:/bin/ash
+kevin:x:1026:100:Kevin:/var/services/homes/kevin:/sbin/nologin
+lisa:x:1027:100:Lisa:/var/services/homes/lisa:/sbin/nologin
+syrvis-operator:x:1030:100:SyrvisCore MCP operator:/var/services/homes/syrvis-operator:/bin/sh
+syrvis-reader:x:1031:100:SyrvisCore reader:/var/services/homes/syrvis-reader:/bin/sh
+"""
+
+GROUP = """users:x:100:kevin,lisa
+administrators:x:101:cerebrate
+docker:x:999:syrvis-operator,cerebrate
+homes:x:106:
+"""
+
+
+def spec(**over):
+    d = {"shell": "/sbin/nologin", "groups": ["users"]}
+    d.update(over)
+    return d
+
+
+def payload(**users):
+    return {"apiVersion": USERS_API_VERSION, "users": users or {"kevin": spec()}}
+
+
+@pytest.fixture
+def etc(tmp_path):
+    passwd = tmp_path / "passwd"
+    group = tmp_path / "group"
+    passwd.write_text(PASSWD)
+    group.write_text(GROUP)
+    return passwd, group
+
+
+class FakeSynoTools:
+    """Models synouser/synogroup against the tmp passwd/group files — including
+    the DSM trap: every mutation regenerates passwd, reverting the seam
+    accounts to /sbin/nologin (the 2026-07-28 live discovery)."""
+
+    def __init__(self, passwd, group, revert_seam_shells=True, fail=()):
+        self.passwd = passwd
+        self.group = group
+        self.revert_seam_shells = revert_seam_shells
+        self.fail = set(fail)  # binaries whose calls should fail
+        self.calls = []
+
+    def __call__(self, argv):
+        self.calls.append(list(argv))
+        tool = argv[0].rsplit("/", 1)[-1]
+        if tool in self.fail:
+            return "mock failure", 1
+        if tool == "synouser" and argv[1] == "--add":
+            name, _pw, full_name = argv[2], argv[3], argv[4]
+            self.passwd.write_text(
+                self.passwd.read_text()
+                + "{}:x:1050:100:{}:/var/services/homes/{}:/sbin/nologin\n".format(
+                    name, full_name, name
+                )
+            )
+            self._regenerate()
+            return "", 0
+        if tool == "synogroup" and argv[1] == "--memberadd":
+            group_name, member = argv[2], argv[3]
+            lines = []
+            for line in self.group.read_text().splitlines():
+                parts = line.split(":")
+                if parts[0] == group_name:
+                    members = [m for m in parts[3].split(",") if m]
+                    if member not in members:
+                        members.append(member)
+                    parts[3] = ",".join(members)
+                lines.append(":".join(parts))
+            self.group.write_text("\n".join(lines) + "\n")
+            self._regenerate()
+            return "", 0
+        raise AssertionError("unexpected tool call: {}".format(argv))
+
+    def _regenerate(self):
+        """DSM regenerates /etc/passwd on ANY user-database write, resetting
+        the seam accounts' shells to nologin."""
+        if not self.revert_seam_shells:
+            return
+        lines = []
+        for line in self.passwd.read_text().splitlines():
+            parts = line.split(":")
+            if parts[0] in ("syrvis-operator", "syrvis-reader") and len(parts) >= 7:
+                parts[6] = "/sbin/nologin"
+            lines.append(":".join(parts))
+        self.passwd.write_text("\n".join(lines) + "\n")
+
+
+def backend(etc, **kw):
+    passwd, group = etc
+    fake = FakeSynoTools(passwd, group, **kw)
+    b = DsmUserBackend(passwd_path=passwd, group_path=group, run=fake)
+    return b, fake
+
+
+# ---------------------------------------------------------------------------
+# Schema
+# ---------------------------------------------------------------------------
+
+
+class TestParse:
+    def test_wrong_api_version(self):
+        with pytest.raises(UserError, match="apiVersion"):
+            UsersBundle.from_dict({"apiVersion": "syrvis-users/v9", "users": {"k": spec()}})
+
+    def test_empty_users(self):
+        with pytest.raises(UserError, match="non-empty"):
+            UsersBundle.from_dict({"apiVersion": USERS_API_VERSION, "users": {}})
+
+    @pytest.mark.parametrize("name", ["", "Kevin", "bad name", "-lead", "x" * 65])
+    def test_invalid_usernames(self, name):
+        with pytest.raises(UserError, match="username"):
+            UsersBundle.from_dict(payload(**{name: spec()}))
+
+    def test_password_field_is_structurally_impossible(self):
+        """THE boundary: no password key exists — unknown keys are rejected."""
+        with pytest.raises(UserError, match="unknown keys"):
+            UsersBundle.from_dict(payload(kevin=spec(password="hunter2")))
+
+    def test_privileged_groups_refused(self):
+        with pytest.raises(UserError, match="OWNER-DECISION"):
+            UsersBundle.from_dict(payload(kevin=spec(groups=["users", "docker"])))
+        with pytest.raises(UserError, match="OWNER-DECISION"):
+            UsersBundle.from_dict(payload(kevin=spec(groups=["administrators"])))
+
+    def test_shell_enum(self):
+        with pytest.raises(UserError, match="shell"):
+            UsersBundle.from_dict(payload(kevin=spec(shell="/bin/bash")))
+
+    def test_full_name_colon_rejected(self):
+        with pytest.raises(UserError, match="full_name"):
+            UsersBundle.from_dict(payload(kevin=spec(full_name="a:b")))
+
+    def test_valid_defaults(self):
+        b = UsersBundle.from_dict(payload())
+        assert b.users["kevin"] == {
+            "full_name": "",
+            "shell": "/sbin/nologin",
+            "groups": ["users"],
+        }
+
+
+# ---------------------------------------------------------------------------
+# Backend (tmp files; fake tools)
+# ---------------------------------------------------------------------------
+
+
+class TestBackend:
+    def test_get_user_and_groups(self, etc):
+        b, _ = backend(etc)
+        u = b.get_user("kevin")
+        assert u["uid"] == 1026 and u["shell"] == "/sbin/nologin"
+        assert b.groups_of("kevin") == ["users"]
+        assert b.get_user("nobody-here") is None
+
+    def test_set_shell_surgical(self, etc):
+        passwd, _ = etc
+        b, _ = backend(etc)
+        before = passwd.read_text()
+        b.set_shell("kevin", "/bin/sh")
+        after = passwd.read_text()
+        assert "kevin:x:1026:100:Kevin:/var/services/homes/kevin:/bin/sh" in after
+        # Only the one field of the one row changed; everything else intact.
+        assert after.count("\n") == before.count("\n")
+        assert after.replace(":/bin/sh", ":/sbin/nologin").count("root:x:0:0") == 1
+        assert b.get_user("lisa")["shell"] == "/sbin/nologin"
+
+    def test_set_shell_missing_user_raises(self, etc):
+        b, _ = backend(etc)
+        with pytest.raises(UserError, match="not found"):
+            b.set_shell("ghost", "/bin/sh")
+
+    def test_add_user_argv_form(self, etc):
+        """The provision script's proven form: name, random throwaway pw,
+        fullname, expired=0, no mail, no app privilege."""
+        b, fake = backend(etc)
+        b.add_user("anton", "Anton Yamos")
+        argv = fake.calls[-1]
+        assert argv[0] == "/usr/syno/sbin/synouser" and argv[1] == "--add"
+        assert argv[2] == "anton" and argv[4] == "Anton Yamos"
+        assert argv[5:] == ["0", "", ""]
+        randpw = argv[3]
+        assert len(randpw) == 48 and all(c in "0123456789abcdef" for c in randpw)
+
+    def test_add_to_group_argv_form(self, etc):
+        b, fake = backend(etc)
+        b.add_to_group("users", "anton")
+        assert fake.calls[-1] == ["/usr/syno/sbin/synogroup", "--memberadd", "users", "anton"]
+
+
+# ---------------------------------------------------------------------------
+# Converge (plan -> apply -> re-read + seam self-heal)
+# ---------------------------------------------------------------------------
+
+
+class TestDeclare:
+    def test_unchanged_user_mutates_nothing(self, etc):
+        b, fake = backend(etc)
+        report = declare_users(UsersBundle.from_dict(payload()), b)
+        assert report["ok"] is True
+        assert report["users"]["kevin"]["action"] == "unchanged"
+        assert fake.calls == []  # no synouser/synogroup call at all
+
+    def test_create_missing_user_with_seam_selfheal(self, etc):
+        """Creating a user trips DSM's passwd regeneration (seam shells revert
+        to nologin); the SAME invocation must heal them back to /bin/sh."""
+        passwd, _ = etc
+        b, fake = backend(etc)
+        bundle = UsersBundle.from_dict(
+            payload(anton=spec(full_name="Anton Yamos", groups=["users"]))
+        )
+        report = declare_users(bundle, b)
+        assert report["ok"] is True, report
+        entry = report["users"]["anton"]
+        assert entry["action"] == "create" and entry["converged"] is True
+        assert "password: unset (owner ceremony required)" in entry["notes"]
+        # The trap fired (fake reverted the seam shells) — and was healed.
+        assert report["seam_selfheal"] == {
+            "syrvis-operator": "healed",
+            "syrvis-reader": "healed",
+        }
+        text = passwd.read_text()
+        assert "syrvis-operator:" in text
+        for seam_user in ("syrvis-operator", "syrvis-reader"):
+            row = [line for line in text.splitlines() if line.startswith(seam_user + ":")][0]
+            assert row.endswith(":/bin/sh")
+
+    def test_no_mutation_no_heal_needed(self, etc):
+        b, _ = backend(etc)
+        report = declare_users(UsersBundle.from_dict(payload()), b)
+        assert report["seam_selfheal"] == {"syrvis-operator": "ok", "syrvis-reader": "ok"}
+
+    def test_shell_converge(self, etc):
+        b, _ = backend(etc)
+        bundle = UsersBundle.from_dict(payload(kevin=spec(shell="/bin/sh")))
+        report = declare_users(bundle, b)
+        entry = report["users"]["kevin"]
+        assert entry["action"] == "update"
+        assert entry["changes"]["shell"] == {"from": "/sbin/nologin", "to": "/bin/sh"}
+        assert b.get_user("kevin")["shell"] == "/bin/sh"
+
+    def test_groups_additive_only(self, etc):
+        """Missing memberships are added; extra memberships are reported and
+        NEVER removed (no removal call shape even exists in the backend)."""
+        b, fake = backend(etc)
+        bundle = UsersBundle.from_dict(payload(kevin=spec(groups=["users", "homes"])))
+        # 'homes' doesn't exist as a membership -> planned add; kevin's other
+        # memberships (none beyond users) stay untouched.
+        report = declare_users(bundle, b)
+        entry = report["users"]["kevin"]
+        assert entry["changes"]["groups"] == {"add": ["homes"]}
+        assert ["/usr/syno/sbin/synogroup", "--memberadd", "homes", "kevin"] in fake.calls
+        assert not any("--memberdel" in c for call in fake.calls for c in call)
+        # The fake applies the membership, so the re-read converges.
+        assert entry["converged"] is True and report["ok"] is True
+
+    def test_unmanaged_groups_reported_not_removed(self, etc):
+        passwd, group = etc
+        group.write_text("users:x:100:kevin,lisa\nstaff:x:105:kevin\n")
+        b, fake = backend(etc)
+        report = declare_users(UsersBundle.from_dict(payload()), b)
+        entry = report["users"]["kevin"]
+        assert entry["unmanaged_groups"] == ["staff"]
+        assert fake.calls == []
+        assert "kevin" in group.read_text().split("staff:x:105:")[1]
+
+    def test_full_name_drift_is_report_only(self, etc):
+        b, fake = backend(etc)
+        bundle = UsersBundle.from_dict(payload(kevin=spec(full_name="Kevin T")))
+        report = declare_users(bundle, b)
+        entry = report["users"]["kevin"]
+        assert entry["action"] == "unchanged"
+        assert any("full_name drift" in n for n in entry["notes"])
+        assert fake.calls == []
+
+    def test_payload_scope_never_touches_unnamed_users(self, etc):
+        b, fake = backend(etc)
+        bundle = UsersBundle.from_dict(payload(kevin=spec(shell="/bin/sh")))
+        declare_users(bundle, b)
+        assert b.get_user("lisa")["shell"] == "/sbin/nologin"  # untouched
+        assert not any("lisa" in c for call in fake.calls for c in call)
+
+    def test_dry_run_mutates_nothing(self, etc):
+        passwd, _ = etc
+        before = passwd.read_text()
+        b, fake = backend(etc)
+        bundle = UsersBundle.from_dict(payload(anton=spec()))
+        report = declare_users(bundle, b, dry_run=True)
+        assert report["dry_run"] is True and report["ok"] is True
+        assert report["users"]["anton"]["action"] == "create"
+        assert "seam_selfheal" not in report  # a plan heals nothing
+        assert fake.calls == [] and passwd.read_text() == before
+
+    def test_create_failure_aggregated(self, etc):
+        b, fake = backend(etc, fail=("synouser",))
+        bundle = UsersBundle.from_dict(payload(anton=spec(), kevin=spec(shell="/bin/sh")))
+        report = declare_users(bundle, b)
+        assert report["ok"] is False
+        assert report["users"]["anton"]["errors"]
+        # The other user still converged in the same run.
+        assert report["users"]["kevin"]["converged"] is True
+
+    def test_no_delete_or_disable_surface(self):
+        surface = [m for m in dir(DsmUserBackend) if not m.startswith("_")]
+        assert not any(
+            "delete" in m or "remove" in m or "disable" in m or "expire" in m for m in surface
+        )
